             if (activeCallRole === 'caller' && call.status === 'accepted' && call.answer_sdp && pc && !pc.currentRemoteDescription) {
                 pc.setRemoteDescription(new RTCSessionDescription(JSON.parse(call.answer_sdp)))
                     .then(function () { setCallStatusText(''); })
@@ -484,6 +500,7 @@
