     senior_pwd_type       NVARCHAR(10) NULL,     -- 'senior', 'pwd', or NULL if not applied
     senior_pwd_id_number  NVARCHAR(50) NULL,      -- Senior Citizen / PWD ID printed on the receipt for compliance
