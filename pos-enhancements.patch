diff --git a/app/models/Role.php b/app/models/Role.php
index 498612c..a6b5623 100644
--- a/app/models/Role.php
+++ b/app/models/Role.php
@@ -133,4 +133,32 @@ class Role
             throw $e;
         }
     }
+
+    /**
+     * Whether a role has been granted a specific permission (by key, e.g.
+     * 'pos.access'). Administrator implicitly has every permission - it's
+     * the superuser role and was never meant to be individually toggled
+     * off in the Roles & Permissions matrix, so it's short-circuited here
+     * rather than depending on someone remembering to check every box.
+     */
+    public function hasPermission(int $roleId, string $permissionKey): bool
+    {
+        $roleStmt = $this->db->prepare('SELECT role_name FROM Roles WHERE role_id = :id');
+        $roleStmt->bindValue(':id', $roleId, PDO::PARAM_INT);
+        $roleStmt->execute();
+        $roleName = $roleStmt->fetch()['role_name'] ?? null;
+        if ($roleName === 'Administrator') {
+            return true;
+        }
+
+        $stmt = $this->db->prepare(
+            "SELECT 1 FROM RolePermissions rp
+             INNER JOIN Permissions p ON p.permission_id = rp.permission_id
+             WHERE rp.role_id = :role_id AND p.permission_key = :permission_key"
+        );
+        $stmt->bindValue(':role_id', $roleId, PDO::PARAM_INT);
+        $stmt->bindValue(':permission_key', $permissionKey, PDO::PARAM_STR);
+        $stmt->execute();
+        return (bool) $stmt->fetch();
+    }
 }
