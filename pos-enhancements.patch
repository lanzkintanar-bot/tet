From 43ff6be7c8a271e3c66084503309f95d7a3fce61 Mon Sep 17 00:00:00 2001
From: Claude <assistant@example.com>
Date: Fri, 21 Aug 2026 19:24:23 +0000
Subject: [PATCH 08/22] Fix per-item discount cap mismatch between client and
 server (found via fuzz testing)

Sale::priceCart() caps a per-item manual discount at what's left of the
line AFTER its own automatic discount_rate (lineSubtotal - productDiscount).
The client (computeTotals(), the per-line Total display, and the Edit
Discount modal's preview/apply) never applied that same cap - it either
didn't cap at all, or capped against the gross line/unit price instead
of the net-of-auto-discount amount.

This meant a large enough per-item discount could pass the client's
own math while the server (correctly) charged more, causing exactly
the class of 'payment covers the total, checkout rejects it anyway'
symptom reported. Verified via a 500-iteration randomized fuzz test
comparing the client and server formulas side by side: 3 real
mismatches before this fix, 0 after.
---
 assets/js/pos.js | 29 ++++++++++++++++++++++-------
 1 file changed, 22 insertions(+), 7 deletions(-)

diff --git a/assets/js/pos.js b/assets/js/pos.js
index 6a013a4..e347552 100644
--- a/assets/js/pos.js
+++ b/assets/js/pos.js
@@ -308,7 +308,14 @@
         cart.forEach(function (item) {
             const lineSubtotalCents = toCents(item.unit_price) * item.quantity;
             const lineTaxCents = Math.round(lineSubtotalCents * (item.tax_rate / 100));
-            const lineDiscountCents = Math.round(lineSubtotalCents * (item.discount_rate / 100)) + Math.max(0, toCents(item.discount));
+            // Mirrors Sale::priceCart() exactly: a per-item manual discount
+            // can't exceed what's left on the line after its own automatic
+            // discount_rate - otherwise a line could go "negative" here
+            // while the server (which does cap it) charges more, causing a
+            // client/server total mismatch at checkout.
+            const autoDiscountCents = Math.round(lineSubtotalCents * (item.discount_rate / 100));
+            const manualLineDiscountCents = Math.min(Math.max(0, toCents(item.discount)), Math.max(0, lineSubtotalCents - autoDiscountCents));
+            const lineDiscountCents = autoDiscountCents + manualLineDiscountCents;
             subtotalCents += lineSubtotalCents;
             taxTotalCents += lineTaxCents;
             lineDiscountTotalCents += lineDiscountCents;
@@ -386,7 +393,7 @@
             cart.forEach(function (item) {
                 const lineSubtotal = item.unit_price * item.quantity;
                 const autoDiscount = Math.round(lineSubtotal * (item.discount_rate / 100) * 100) / 100;
-                const manualDiscount = Number(item.discount) || 0;
+                const manualDiscount = Math.min(Math.max(0, Number(item.discount) || 0), Math.max(0, lineSubtotal - autoDiscount));
                 // The Total column is price x quantity minus this line's own
                 // discounts - it should read exactly like the price tag
                 // times the quantity. Tax is a store-wide add-on shown only
@@ -506,10 +513,16 @@
 
         const type = $('input[name="editDiscountType"]:checked').val();
         const rawValue = Math.max(0, Number($('#editDiscountValue').val()) || 0);
+        // Mirrors Sale::priceCart(): a manual discount can't cut into the
+        // product's own automatic discount_rate twice - cap against what's
+        // left of the unit price after that auto-discount, not the full
+        // catalog/bargained price.
+        const autoDiscountPerUnit = item.unit_price * (item.discount_rate / 100);
+        const capPerUnit = Math.max(0, item.unit_price - autoDiscountPerUnit);
         const perUnitDiscount = type === 'percent'
-            ? item.unit_price * Math.min(rawValue, 100) / 100
